# Production Environment Configuration
# Core Settings
DEBUG=False
ALLOWED_HOSTS=80.134.74.61,localhost,127.0.0.1
TIME_ZONE=UTC
DEMO_MODE=False

# WhiteNoise for production static files serving
WHITENOISE_CONFIG=True

# Database - PostgreSQL (Production)
POSTGRE_DB=True
MYSQL_DB=False

# PostgreSQL Database Configuration
DB_NAME=django_dev
DB_USER=django_user
DB_PASSWORD=django_pass
DB_HOST=postgres_db
DB_PORT=5432

# Email Configuration (Update with your SMTP details)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Media Files Path (Docker)
MEDIA_ROOT=media
